# Server
PORT=5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/clicky

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_64_char_hex
JWT_REFRESH_SECRET=replace_with_different_64_char_hex

# Admin seed credentials (used only by `npm run seed`)
ADMIN_EMAIL=admin@clicky.dev
ADMIN_PASSWORD=replace_with_strong_password

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000
